generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  PLANNER
  VIEWER
}

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  status             TenantStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  users              User[]
  invites            Invite[]
  auditLogs          AuditLog[]
  subscription       Subscription?
  invoices           Invoice[]
  usageCounters      UsageCounter[]
  notifications      Notification[]
  aiRequests         AiRequest[]
  jobs               Job[]
  categories         Category[]
  products           Product[]
  locations          Location[]
  suppliers          Supplier[]
  supplierProducts   SupplierProduct[]
  bomItems           BomItem[]
  inventoryLevels    InventoryLevel[]
  openOrders         OpenOrder[]
  salesImports       SalesImport[]
  salesRecords       SalesRecord[]
  forecastRuns       ForecastRun[]
  forecastResults    ForecastResult[]
  forecastAccuracies ForecastAccuracy[]
  forecastOverrides  ForecastOverride[]
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String
  name          String
  role          Role
  isActive      Boolean              @default(true)
  lastLoginAt   DateTime?
  failedLogins  Int                  @default(0)
  lockedUntil   DateTime?
  tenantId      String?
  tenant        Tenant?              @relation(fields: [tenantId], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([action])
  @@index([actorId])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum InvoiceStatus {
  PENDING
  PAID
  VOID
}

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  priceCents    Int
  limits        Json
  isActive      Boolean        @default(true)
  isPublic      Boolean        @default(true)
  isCustom      Boolean        @default(false)
  sortOrder     Int            @default(100)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[] @relation("CurrentPlan")
  pendingFor    Subscription[] @relation("PendingPlan")
}

model Subscription {
  id            String             @id @default(cuid())
  tenantId      String             @unique
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan               @relation("CurrentPlan", fields: [planId], references: [id])
  pendingPlanId String?
  pendingPlan   Plan?              @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  status        SubscriptionStatus @default(ACTIVE)
  periodStart   DateTime
  periodEnd     DateTime
  trialEndsAt   DateTime?
  convertedAt   DateTime?
  customLimits  Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  invoices      Invoice[]

  @@index([planId])
  @@index([status, periodEnd])
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  number         String        @unique
  amountCents    Int
  status         InvoiceStatus @default(PAID)
  planName       String
  description    String
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId])
}

model InvoiceSequence {
  year Int @id
  last Int @default(0)
}

model UsageCounter {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric      String
  periodStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, metric, periodStart])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, userId, readAt])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model Job {
  id        String    @id @default(cuid())
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  runAfter  DateTime  @default(now())
  lastError String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([tenantId])
}

model AiRequest {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?
  feature      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  status       String
  latencyMs    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, createdAt])
}

enum LocationType {
  WAREHOUSE
  STORE
  PLANT
}

model Category {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tenantId])
}

model Product {
  id                 String             @id @default(cuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku                String
  name               String
  categoryId         String?
  category           Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitCostCents      Int                @default(0)
  unitPriceCents     Int                @default(0)
  isComponent        Boolean            @default(false)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  supplierProducts   SupplierProduct[]
  bomAsParent        BomItem[]          @relation("BomParent")
  bomAsComponent     BomItem[]          @relation("BomComponent")
  inventoryLevels    InventoryLevel[]
  openOrders         OpenOrder[]
  salesRecords       SalesRecord[]
  forecastResults    ForecastResult[]
  forecastAccuracies ForecastAccuracy[]
  forecastOverrides  ForecastOverride[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
}

model Location {
  id                 String             @id @default(cuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code               String
  name               String
  type               LocationType       @default(WAREHOUSE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  inventoryLevels    InventoryLevel[]
  openOrders         OpenOrder[]
  salesRecords       SalesRecord[]
  forecastResults    ForecastResult[]
  forecastAccuracies ForecastAccuracy[]
  forecastOverrides  ForecastOverride[]

  @@unique([tenantId, code])
}

model Supplier {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  defaultLeadTimeDays Int
  reliabilityPct      Decimal           @default(95) @db.Decimal(5, 2)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  products            SupplierProduct[]
  openOrders          OpenOrder[]

  @@index([tenantId])
}

model SupplierProduct {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  leadTimeDays   Int
  minOrderQty    Decimal  @default(1) @db.Decimal(14, 3)
  unitCostCents  Int      @default(0)
  weeklyCapacity Decimal? @db.Decimal(14, 3)
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([tenantId, productId])
}

model BomItem {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentProductId    String
  parent             Product  @relation("BomParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  componentProductId String
  component          Product  @relation("BomComponent", fields: [componentProductId], references: [id], onDelete: Cascade)
  quantityPer        Decimal  @db.Decimal(14, 4)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([parentProductId, componentProductId])
  @@index([tenantId])
}

model InventoryLevel {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHand      Decimal  @db.Decimal(14, 3)
  safetyStock Decimal  @default(0) @db.Decimal(14, 3)
  asOfDate    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, productId, locationId])
}

model OpenOrder {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quantity     Decimal   @db.Decimal(14, 3)
  expectedDate DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, expectedDate])
}

enum ImportStatus {
  PREVIEW
  QUEUED
  PROCESSING
  DONE
  FAILED
}

model SalesImport {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName      String
  status        ImportStatus  @default(PREVIEW)
  rowCount      Int           @default(0)
  validRowCount Int           @default(0)
  errorCount    Int           @default(0)
  errors        Json?
  previewRows   Json?
  importedRows  Int           @default(0)
  errorMessage  String?       @db.Text
  rawCsv        String?       @db.LongText
  createdBy     String?
  committedAt   DateTime?
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  records       SalesRecord[]

  @@index([tenantId, createdAt])
}

model SalesRecord {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId   String
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  date         DateTime     @db.Date
  quantity     Decimal      @db.Decimal(14, 3)
  revenueCents Decimal      @default(0) @db.Decimal(18, 0)
  importId     String?
  import       SalesImport? @relation(fields: [importId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, productId, locationId, date])
  @@index([tenantId, date])
}

enum RunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model ForecastRun {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status       RunStatus          @default(PENDING)
  horizonWeeks Int
  method       String
  filters      Json
  progress     Int                @default(0)
  seriesTotal  Int                @default(0)
  seriesDone   Int                @default(0)
  seriesFailed Int                @default(0)
  failures     Json?
  asOfWeek     DateTime?          @db.Date
  startedAt    DateTime?
  finishedAt   DateTime?
  error        String?            @db.Text
  createdBy    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  results      ForecastResult[]
  accuracies   ForecastAccuracy[]

  @@index([tenantId, createdAt])
}

model ForecastResult {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId      String
  run        ForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  weekStart  DateTime    @db.Date
  quantity   Decimal     @db.Decimal(14, 3)
  lower      Decimal     @db.Decimal(14, 3)
  upper      Decimal     @db.Decimal(14, 3)
  modelUsed  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([runId, productId, locationId])
  @@index([tenantId])
}

model ForecastAccuracy {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId      String
  run        ForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  modelUsed  String
  reason     String?
  holdout    Int         @default(0)
  mape       Float?
  wape       Float?
  bias       Float?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([runId, productId, locationId])
  @@index([tenantId])
}

model ForecastOverride {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  weekStart  DateTime @db.Date
  quantity   Decimal  @db.Decimal(14, 3)
  reason     String   @db.Text
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, productId, locationId, weekStart])
  @@index([tenantId, weekStart])
}

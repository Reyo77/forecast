{
  "name": "@supplycast/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts src/seed.ts src/seedDemo.ts --bundle --platform=node --target=node20 --outdir=dist --sourcemap --external:@prisma/client --external:pino --external:pino-http --external:.prisma/client",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "jest --runInBand --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "seed:demo": "tsx src/seedDemo.ts",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@prisma/client": "^6.0.0",
    "@supplycast/shared": "^0.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.28.2",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  }
}

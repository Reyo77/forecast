DATABASE_URL=mysql://supplycast:supplycast@localhost:3306/supplycast
DATABASE_URL_TEST=mysql://supplycast:supplycast@localhost:3307/supplycast_test
# Host ports used by docker-compose (change if 3306/3307 are taken)
DEV_DB_PORT=3306
TEST_DB_PORT=3307
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash
SIMULATED_PAYMENTS=true
SUPER_ADMIN_EMAIL=admin@supplycast.local
SUPER_ADMIN_PASSWORD=change-me
# Dev server ports (defaults 4000 / 5173)
PORT=4000
WEB_PORT=5173

# Use "fake" for an offline deterministic AI (dev/e2e only; refused in production)
AI_PROVIDER=gemini

# Auth attempts per IP per 15 min (default 20; raise for local e2e runs)
# AUTH_RATE_LIMIT_MAX=20

# Email: "log" records messages without sending (default). Use "smtp" to deliver for real.
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=SupplyCast <no-reply@yourdomain.com>
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Payments: "simulated" (default) applies a chosen plan instantly. "stripe" sends upgrades to Stripe Checkout
# and activates the plan from a signed webhook: POST <API_URL>/billing/webhook (event: checkout.session.completed).
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
